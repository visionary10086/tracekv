#!/usr/bin/env bpftrace
/*
 * sched_latency.bt — CPU Scheduler Wakeup-to-Run & Preempt-to-Run Latency Tracer
 *
 * Measures two complementary latency paths:
 *   1. Wakeup-to-Run (SCHED): task woken from sleep → scheduled onto CPU
 *   2. Preempt-to-Run (RUNWAIT): task preempted (prev_state==0) → re-scheduled
 *
 * Output format (pipe-delimited):
 *   CLOCK|wall_ns=<realtime_ns>|mono_ns=<monotonic_ns>
 *   HEADER|switch_ns|wakeup_ns|tid|cpu|latency_ns|comm
 *   SCHED|<switch_ns>|<wakeup_ns>|<tid>|<cpu>|<latency_ns>|<comm>
 *   RUNWAIT|<switch_ns>|<preempt_ns>|<tid>|<cpu>|<wait_ns>|<comm>
 *
 * Diagnostic counters are printed on exit with prefix STAT|.
 *
 * Designed for bpftrace >= 0.20.  Fields verified against the running
 * kernel's BTF (6.18.54.1-microsoft-standard-WSL2):
 *   sched_wakeup_template.pid  = target TID (offset 24)
 *   sched_switch.next_pid      = scheduled-in TID (offset 56)
 *   sched_switch.prev_state    = outgoing task state  (offset 32)
 *
 * Author: 邓智文 (DAGER)
 * Project: TraceKV — collector/ebpf/sched_latency.bt
 */

#ifndef TARGET_TGID
#define TARGET_TGID 0
#endif

BEGIN
{
    /* E0: emit clock anchor so userspace can convert mono→wall */
    printf("CLOCK|wall_ns=%llu|mono_ns=%llu\n",
           (uint64)nsecs(realtime), (uint64)nsecs(monotonic));
    printf("HEADER|switch_ns|wakeup_ns|tid|cpu|latency_ns|comm\n");
    @dup_wakeup = 0;
    @unmatched_switch = 0;
    @exit_cleanup = 0;
    @matched = 0;
    @map_overflow = 0;
    @runwait_matched = 0;
}

/*
 * sched_wakeup / sched_wakeup_new
 *
 * args->pid is the TID of the TARGET task being woken.
 * args->comm is the target task's name.
 *
 * Defensive filtering: exclude tracer itself (bpftrace/python3) from being
 * tracked to break the recursive self-triggering feedback loop.
 */
tracepoint:sched:sched_wakeup
{
    if (args.comm == "bpftrace" || args.comm == "python3" || args.comm == "python") {
        return;
    }
    if (@enqueue_ts[args.pid] == 0) {
        @enqueue_ts[args.pid] = nsecs(monotonic);
    } else {
        @dup_wakeup++;
    }
}

tracepoint:sched:sched_wakeup_new
{
    if (args.comm == "bpftrace" || args.comm == "python3" || args.comm == "python") {
        return;
    }
    if (@enqueue_ts[args.pid] == 0) {
        @enqueue_ts[args.pid] = nsecs(monotonic);
    } else {
        @dup_wakeup++;
    }
}

/*
 * sched_switch
 *
 * Handles two latency paths:
 *   Path A — Wakeup-to-Run (SCHED)
 *   Path B — Preempt-to-Run (RUNWAIT, E1)
 *
 * Defensive filtering:
 * 1. Skip tracer processes to prevent probe-induced latency distortion.
 * 2. If TARGET_TGID != 0 is specified, bypass events for tasks that do not
 *    belong to the target process tree.
 */
tracepoint:sched:sched_switch
{
    /* Cut off tracer self-interference */
    if (args.next_comm == "bpftrace" || args.next_comm == "python3" || args.next_comm == "python") {
        return;
    }
    if (args.prev_comm == "bpftrace" || args.prev_comm == "python3" || args.prev_comm == "python") {
        return;
    }

    /* Optional in-kernel early filtering by TGID */
    if (TARGET_TGID != 0 && curtask->tgid != TARGET_TGID) {
        /* If outgoing task is not target, don't record preempt for it */
    } else {
        /* --- Path B: record preempt timestamp for outgoing TASK_RUNNING task --- */
        if (args.prev_state == 0 && args.prev_pid != 0) {
            if (@preempt_ts[args.prev_pid] == 0) {
                @preempt_ts[args.prev_pid] = nsecs(monotonic);
            }
        }
    }

    /* --- Path A: Wakeup-to-Run --- */
    $wakeup_ts = @enqueue_ts[args.next_pid];
    if ($wakeup_ts != 0) {
        $switch_ts = nsecs(monotonic);
        $latency = $switch_ts - $wakeup_ts;
        printf("SCHED|%llu|%llu|%d|%d|%llu|%s\n",
               $switch_ts, $wakeup_ts, args.next_pid, cpu, $latency,
               args.next_comm);
        delete(@enqueue_ts[args.next_pid]);
        /* clear any stale preempt record for the same TID */
        delete(@preempt_ts[args.next_pid]);
        @matched++;
    } else {
        /* --- Path B: Preempt-to-Run --- */
        $preempt_ts = @preempt_ts[args.next_pid];
        if ($preempt_ts != 0) {
            $switch_ts = nsecs(monotonic);
            $wait = $switch_ts - $preempt_ts;
            printf("RUNWAIT|%llu|%llu|%d|%d|%llu|%s\n",
                   $switch_ts, $preempt_ts, args.next_pid, cpu, $wait,
                   args.next_comm);
            delete(@preempt_ts[args.next_pid]);
            @runwait_matched++;
        } else {
            if (args.next_pid != 0) {
                @unmatched_switch++;
            }
        }
    }
}

/*
 * sched_process_exit — clean up map entries for exiting tasks.
 * args->pid here is the TID of the exiting task.
 */
tracepoint:sched:sched_process_exit
{
    if (@enqueue_ts[args.pid] != 0) {
        delete(@enqueue_ts[args.pid]);
        @exit_cleanup++;
    }
    if (@preempt_ts[args.pid] != 0) {
        delete(@preempt_ts[args.pid]);
        @exit_cleanup++;
    }
}

END
{
    printf("STAT|matched|%llu\n", @matched);
    printf("STAT|runwait_matched|%llu\n", @runwait_matched);
    printf("STAT|dup_wakeup|%llu\n", @dup_wakeup);
    printf("STAT|unmatched_switch|%llu\n", @unmatched_switch);
    printf("STAT|exit_cleanup|%llu\n", @exit_cleanup);
    printf("STAT|map_overflow|%llu\n", @map_overflow);
    clear(@enqueue_ts);
    clear(@preempt_ts);
    clear(@dup_wakeup);
    clear(@unmatched_switch);
    clear(@exit_cleanup);
    clear(@matched);
    clear(@runwait_matched);
    clear(@map_overflow);
}
